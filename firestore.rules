rules_version = '2';

// Exam Hall Seating — Firestore security model
//
//   colleges/{uid}/**                 → private admin workspace (owner only)
//   publicExams/{examId}              → readable by id (no listing), owner-writable
//   publicExams/{examId}/seats/{ht}   → world-readable (students search), owner-writable
//   attendance/{token}                → one sheet per exam + hall. The token is the
//                                       invigilator's private link: whoever holds it can
//                                       read the sheet and submit absentees, nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    match /colleges/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /publicExams/{examId} {
      // get by id only — the list of every college's exams is not public
      allow get: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      match /seats/{hallTicket} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.uid == get(/databases/$(database)/documents/publicExams/$(examId)).data.ownerUid;
      }
    }

    // Students search "seats" across all exams by hall ticket.
    match /{path=**}/seats/{hallTicket} {
      allow read: if true;
    }

    match /attendance/{token} {
      allow get: if true;                       // the token is the secret
      allow list: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerUid
                    // link holders may only touch the attendance fields
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['absentHallTickets', 'submitted', 'submittedAt']);
    }
  }
}
